{
  "openapi": "3.1.0",
  "info": {
    "title": "User Registration & Job Profile API",
    "description": "Register users with job profile data, log in with JWT, and retrieve your own profile.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user with job profile data",
        "description": "Create a new user.\n\nErrors:\n  * 409 Conflict - email or phone number already registered\n  * 422          - request body fails validation (handled by FastAPI)",
        "operationId": "register_api_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate and receive a JWT access token",
        "description": "Verify credentials and return a JWT access token.\n\nAccepts the documented JSON body ``{\"email\": ..., \"password\": ...}`` and\nalso the OAuth2 form used by Swagger's Authorize button.\n\nErrors:\n  * 401 Unauthorized - invalid email or password",
        "operationId": "login_api_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "type": "object",
                "required": [
                  "email",
                  "password"
                ]
              },
              "example": {
                "email": "rahul@example.com",
                "password": "SecurePass123"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get the logged-in user's profile",
        "description": "Return the authenticated user's profile \u2014 the same data supplied at\nregistration.\n\nRequires an ``Authorization: Bearer <token>`` header.\n\nErrors:\n  * 401 Unauthorized - token missing, invalid, or expired",
        "operationId": "read_current_user_api_users_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/upload": {
      "post": {
        "tags": [
          "Upload"
        ],
        "summary": "Upload a file (max 200 MB)",
        "description": "Upload a single file.\n\nThe file is streamed to disk in chunks; if it exceeds 200 MB the partial\nfile is removed and the request is rejected.\n\nRequires an ``Authorization: Bearer <token>`` header.\n\nErrors:\n  * 400 Bad Request   - no filename supplied\n  * 401 Unauthorized  - token missing, invalid, or expired\n  * 413 Payload Too Large - file exceeds the 200 MB limit",
        "operationId": "upload_file_api_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_api_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Upload File Api Upload Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Root",
        "description": "Simple health/info endpoint.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_file_api_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_file_api_upload_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Token": {
        "properties": {
          "authToken": {
            "type": "string",
            "title": "Authtoken",
            "description": "Signed JWT bearer token"
          },
          "status_code": {
            "type": "integer",
            "title": "Status Code",
            "description": "HTTP status code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable result message"
          },
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Whether the login succeeded"
          }
        },
        "type": "object",
        "required": [
          "authToken",
          "status_code",
          "message",
          "success"
        ],
        "title": "Token",
        "description": "Login response returned by ``POST /api/login``."
      },
      "UserCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "Full name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Valid, unique email address"
          },
          "phone_number": {
            "type": "string",
            "maxLength": 20,
            "minLength": 7,
            "title": "Phone Number",
            "description": "Unique phone number"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "title": "Password",
            "description": "At least 8 characters"
          },
          "job_title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Job Title"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Skills",
            "description": "Non-empty list of skills"
          },
          "job_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Description",
            "description": "Optional summary"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "phone_number",
          "password",
          "job_title",
          "skills"
        ],
        "title": "UserCreate",
        "description": "Registration input. All job fields required except ``job_description``."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "phone_number": {
            "type": "string",
            "title": "Phone Number"
          },
          "job_title": {
            "type": "string",
            "title": "Job Title"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          },
          "job_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Description"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "authToken": {
            "type": "string",
            "title": "Authtoken",
            "description": "Signed JWT bearer token issued on registration"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone_number",
          "job_title",
          "skills",
          "created_at",
          "authToken"
        ],
        "title": "UserResponse",
        "description": "User JSON returned to clients. Never includes the password hash."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Paste your JWT access token here.",
        "scheme": "bearer"
      }
    }
  }
}